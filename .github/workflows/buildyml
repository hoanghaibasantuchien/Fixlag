name: Build HoangHai APK

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.5'

      # BƯỚC QUAN TRỌNG: Tự động tìm thư mục chứa settings.gradle.kts
      - name: Locate Project Root
        id: locate
        run: |
          if [ -f "settings.gradle.kts" ]; then
            echo "dir=." >> $GITHUB_OUTPUT
          else
            DIR=$(find . -name "settings.gradle.kts" -not -path "*/.*" | head -n 1 | xargs dirname)
            echo "dir=$DIR" >> $GITHUB_OUTPUT
          fi

      - name: Build Debug APK
        working-directory: ${{ steps.locate.outputs.dir }}
        run: gradle assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: HoangHai-apk
          path: ${{ steps.locate.outputs.dir }}/app/build/outputs/apk/debug/*.apk
